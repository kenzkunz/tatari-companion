{
  "type": "information",
  "slug": "patch-165921",
  "title": "October update: confirmed data findings",
  "lead": "Checked 21 October 2026 new patch. These are companion-site findings, separate from official patch notes.",
  "sections": [
    {
      "id": "status",
      "title": "What has been checked",
      "blocks": [
        {
          "id": "evidence",
          "type": "info",
          "title": "Patch data are not in-game verified.",
          "text": "New Patch contains the additions below. Unchanged website datasets are not automatically verified for this patch."
        },
        {
          "id": "scope",
          "type": "text",
          "text": "With new level cap at 3,600, the stats calculator and My Tatari now support recorded account levels 1–3,600. The Horde / Goldrush calculator remains a fixed level-500 comparison."
        }
      ]
    },
    {
      "id": "tatari",
      "title": "Bonobean and account levels",
      "blocks": [
        {
          "id": "bonobean",
          "type": "text",
          "text": "Bonobean, Titanape, Grangutan and Primakong are now integrated across My Tatari, the database, stats calculator, evolution planner, Horde guide/drafter and tierlist tools."
        }
      ]
    },
    {
      "id": "horde",
      "title": "Horde Season 3 configuration",
      "blocks": [
        {
          "id": "difficulties",
          "type": "text",
          "text": "The S3 lists Difficulties 1–6. The obtained data show Difficulty 6 has twice Difficulty 4’s enemy ATK and HP; DEF increases by a smaller amount."
        }
      ]
    },
    {
      "id": "collectibles",
      "title": "Collectible additions",
      "blocks": [
        {
          "id": "accessories",
          "type": "text",
          "text": "Original and color accessory variants are present for Zapup, Sparkit, Pandaroo, Cheerling, Lullely, Funglet, Taptail, Budboo, Cavyzap, Ringtail and Popa."
        },
        {
          "id": "other",
          "type": "table",
          "columns": [
            "Category",
            "Additions"
          ],
          "rows": [
            [
              "Exclusive Tatari backgrounds",
              "Five"
            ],
            [
              "Chat emojis",
              "Punchimp, Snowcub and Bonobean"
            ],
            [
              "Expression bubbles",
              "Voltkit, Hootlet, Momopo, Glowfly and Poakie"
            ]
          ]
        },
        {
          "id": "limits",
          "type": "text",
          "text": "The records confirm additions, not their availability on a particular account or release date. Cosmetic records are separate from saved Glitter ownership."
        }
      ]
    },
    {
      "id": "events",
      "title": "Halloween and battle setup",
      "blocks": [
        {
          "id": "halloween",
          "type": "text",
          "text": "Trick-or-Treat reward configuration and the strings “Trick-or-Treat Time!” and “Halloween Fun!” are present. The event dates and exact replacement schedule are not established, so the site calendar has not been rescheduled from this evidence alone."
        },
        {
          "id": "battles",
          "type": "text",
          "text": "The patch contains 429 new and 404 changed StageBattle files. These counts describe files, not player-facing changes. Their chapter mapping is still under review; formation recommendations have not been recalibrated from the counts alone."
        }
      ]
    },
    {
      "id": "chips",
      "title": "Confirmed chip updates",
      "blocks": [
        {
          "id": "scope",
          "type": "text",
          "text": "The 49 chip catalogue entries, qualities, uniqueness and allowed-wave lists are unchanged. Four numeric changes occur in linked Skill records."
        },
        {
          "id": "values",
          "type": "table",
          "columns": [
            "Chip",
            "Previous value",
            "Patch 165921"
          ],
          "rows": [
            [
              "AFK",
              "300 energizers",
              "400 energizers; still 40 seconds"
            ],
            [
              "First-Aid Kit",
              "15% lost HP",
              "12% lost HP; still every 4 seconds on the first two rows"
            ],
            [
              "Lawn Care",
              "40% Max HP percentage damage",
              "35%; mower count and initial non-boss kills unchanged"
            ],
            [
              "Mission Reset",
              "200 energizers per recalled Tatari",
              "180 energizers"
            ],
            [
              "Backend Support",
              "One Tatari in front",
              "Explicitly one of your own Tatari; still 45% damage boost"
            ]
          ]
        },
        {
          "id": "shuffle",
          "type": "text",
          "text": "Shuffle still grants 600 energizers and will shuffle from both the deployed and undeployed Tatari pool.\n\nContract Employees stay deployed, and their Tatari types are now excluded from the replacement pool. Ordinary replacement units inherit the replaced slots’ grid positions and Horde levels."
        }
      ]
    },
